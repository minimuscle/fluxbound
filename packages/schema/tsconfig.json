{
  "compilerOptions": {
    "noEmit": false,

    "declaration": true,
    "declarationMap": true,

    "outDir": "dist",
    "rootDir": "src",

    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ESNext",

    "verbatimModuleSyntax": true
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
